{
    "name": "sveda-ai/php-sdk",
    "description": "Embed a Sveda AI agent from PHP. Docs: https://sveda.dev/docs/hosts/php",
    "type": "library",
    "license": "AGPL-3.0-only",
    "keywords": ["sveda", "ai", "agent", "copilot", "sdk", "client"],
    "homepage": "https://sveda.dev/docs/hosts/php",
    "authors": [
        {
            "name": "Neresson",
            "homepage": "https://github.com/neresson",
            "role": "Developer"
        }
    ],
    "support": {
        "docs": "https://sveda.dev/docs/hosts/php",
        "issues": "https://github.com/neresson/sveda-php-sdk/issues",
        "source": "https://github.com/neresson/sveda-php-sdk"
    },
    "require": {
        "php": "^8.4",
        "guzzlehttp/guzzle": "^7.9",
        "psr/http-client": "^1.0",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Sveda\\Client\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sveda\\Client\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
